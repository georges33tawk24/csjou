+// JOUCS Gun Game (mp_gungame 1): every kill moves the killer on to the next
+// weapon; whoever gets a kill with the last one, the knife, wins and the game
+// restarts. Levels are kept per player slot.
+static const char *const g_GunGameWeapons[][2] = {
+	{"weapon_glock18", "Glock"}, {"weapon_usp", "USP"}, {"weapon_deagle", "Desert Eagle"}, {"weapon_elite", "Dual Elites"},
+	{"weapon_m3", "M3 shotgun"}, {"weapon_xm1014", "XM1014"}, {"weapon_mac10", "MAC-10"}, {"weapon_mp5navy", "MP5"},
+	{"weapon_p90", "P90"}, {"weapon_galil", "Galil"}, {"weapon_famas", "FAMAS"}, {"weapon_ak47", "AK-47"},
+	{"weapon_m4a1", "M4A1"}, {"weapon_aug", "AUG"}, {"weapon_scout", "Scout"}, {"weapon_awp", "AWP"},
+	{"weapon_m249", "M249"}, {"weapon_hegrenade", "HE grenades"}, {"weapon_knife", "Knife"},
+};
+static const int GUNGAME_LEVELS = sizeof(g_GunGameWeapons) / sizeof(g_GunGameWeapons[0]);
+static int g_GunGameLevel[MAX_CLIENTS + 1];
+
+void JOUCS_GunGameReset(int index)
+{
+	if (index > 0 && index <= MAX_CLIENTS)
+		g_GunGameLevel[index] = 0;
+}
+
+void JOUCS_GunGameGive(CBasePlayer *pPlayer)
+{
+	const int index = pPlayer->entindex();
+	if (index <= 0 || index > MAX_CLIENTS)
+		return;
+
+	const int level = g_GunGameLevel[index];
+	const char *weapon = g_GunGameWeapons[level][0];
+
+	pPlayer->RemoveAllItems(FALSE);
+	pPlayer->GiveNamedItemEx("weapon_knife");
+	if (level < GUNGAME_LEVELS - 1)
+	{
+		CBasePlayerItem *pItem = static_cast<CBasePlayerItem *>(pPlayer->GiveNamedItemEx(weapon));
+		if (pItem && pItem->pszAmmo1())
+			pPlayer->GiveAmmo(pItem->iMaxAmmo1(), pItem->pszAmmo1(), pItem->iMaxAmmo1());
+	}
+	pPlayer->SelectItem(weapon);
+}
+
+void JOUCS_GunGameKill(CBasePlayer *pKiller)
+{
+	const int index = pKiller->entindex();
+	if (index <= 0 || index > MAX_CLIENTS)
+		return;
+
+	char msg[128];
+	if (++g_GunGameLevel[index] >= GUNGAME_LEVELS)
+	{
+		Q_snprintf(msg, sizeof(msg), "%s wins Gun Game!", STRING(pKiller->pev->netname));
+		UTIL_ClientPrintAll(HUD_PRINTCENTER, msg);
+		Q_snprintf(msg, sizeof(msg), "JOUCS_GUNGAME_WIN %s\n", STRING(pKiller->pev->netname));
+		UTIL_ClientPrintAll(HUD_PRINTCONSOLE, msg);
+		Q_memset(g_GunGameLevel, 0, sizeof(g_GunGameLevel));
+		CVAR_SET_FLOAT("sv_restart", 5);
+		return;
+	}
+
+	const int level = g_GunGameLevel[index];
+	Q_snprintf(msg, sizeof(msg), "Level %d/%d: %s", level + 1, GUNGAME_LEVELS, g_GunGameWeapons[level][1]);
+	ClientPrint(pKiller->pev, HUD_PRINTCENTER, msg);
+	Q_snprintf(msg, sizeof(msg), "JOUCS_GUNGAME %d %s\n", level + 1, STRING(pKiller->pev->netname));
+	UTIL_ClientPrintAll(HUD_PRINTCONSOLE, msg);
+
+	if (pKiller->IsAlive())
+		JOUCS_GunGameGive(pKiller);
+}
